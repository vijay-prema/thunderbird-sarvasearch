{
  "manifest_version": 2,
  "name": "Thunderbird AI OmniSearch",
  "description": "Hybrid semantic + keyword search over your Thunderbird mail, powered by local AI (Ollama + Qdrant). Indexes the mail Thunderbird already downloaded - no IMAP.",
  "version": "2.4.3",
  "author": "Vijay Prema",
  "homepage_url": "https://github.com/vijay-prema/thunderbird-ai-omnisearch",
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-omnisearch@vijay-prema.github.io",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "storage",
    "alarms",
    "tabs",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "ingest/dockey.js",
      "ingest/extract.js",
      "ingest/client.js",
      "ingest/reader.js",
      "ingest/open.js",
      "ingest/events.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "AI OmniSearch",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/search-16.svg",
      "32": "icons/search-32.svg"
    }
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Open AI OmniSearch"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/search-16.svg",
    "32": "icons/search-32.svg",
    "64": "icons/search-64.svg"
  }
}
